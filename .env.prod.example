# /etc/icfr/.env 템플릿 (운영 서버에만 실값을 채운다. 이 파일에는 실값 금지 — public repo)
# 배치: sudo install -m 600 -o root -g root .env.prod.example /etc/icfr/.env  → 편집
# 참고: docker-compose.prod.yml 의 4개 서비스가 이 파일 하나를 env_file 로 공유한다.

# === Database (PostgreSQL) ===
# postgres 컨테이너 초기화 및 pg_isready 헬스체크에 사용
POSTGRES_USER=CHANGE_ME
# 강한 랜덤 문자열 (openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=icfr_db
# backend 가 실제로 읽는 접속 문자열. 위 3개 값과 반드시 일치시킬 것 (호스트는 컨테이너명 postgres)
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@postgres:5432/icfr_db

# === MinIO (증빙 파일 저장소) ===
# MinIO 루트 계정 = backend 의 S3 액세스 키/시크릿 (동일 값 사용)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# backend → minio 내부 접속 주소
MINIO_ENDPOINT=minio:9000
# presigned URL 등 외부에 노출되는 주소 (호스트 nginx 미경유, 필요 시 조정)
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=icfr-evidence
MINIO_USE_SSL=false

# === JWT 인증 ===
# 32바이트 이상 랜덤 (openssl rand -hex 32). 교체 시 전체 로그아웃됨
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# === Application ===
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=ICFR System
APP_VERSION=0.1.0

# === 초기 Admin 계정 (기동 시 bootstrap_admin 이 없으면 생성) ===
ADMIN_EMAIL=CHANGE_ME
# 최초 로그인 후 즉시 변경할 것
ADMIN_PASSWORD=CHANGE_ME
# 직책명이 아니라 실제 관리자 실명
ADMIN_DISPLAY_NAME=CHANGE_ME

# === Upload ===
# 증빙 파일 업로드 상한(바이트). 기본 52428800 = 50MiB, nginx client_max_body_size 와 함께 조정
MAX_UPLOAD_BYTES=52428800

# === CORS ===
# 프론트가 같은 도메인에서 서빙되므로 자기 오리진만 허용 (JSON 배열 형식)
CORS_ALLOWED_ORIGINS=["https://icfr.synap.co.kr"]
